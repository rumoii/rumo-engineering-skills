{
  "name": "codex",
  "executable": "codex",
  "verified": {
    "version": "codex-cli 0.162.0",
    "on": "2026-10-23",
    "live_run": true
  },
  "help": [
    {
      "args": [
        "exec",
        "--help"
      ],
      "flags": [
        "--json",
        "--sandbox",
        "--cd",
        "--model",
        "--config"
      ]
    },
    {
      "args": [
        "exec",
        "resume",
        "--help"
      ],
      "flags": [
        "--json",
        "--model",
        "--config"
      ]
    }
  ],
  "prompt": "stdin",
  "access": {
    "read-only": [
      "--sandbox",
      "read-only"
    ],
    "workspace-write": [
      "--sandbox",
      "workspace-write"
    ]
  },
  "resume_access": {
    "read-only": [
      "-c",
      "sandbox_mode=\"read-only\""
    ],
    "workspace-write": [
      "-c",
      "sandbox_mode=\"workspace-write\""
    ]
  },
  "model": [
    "--model",
    "{model}"
  ],
  "effort": [
    "-c",
    "model_reasoning_effort=\"{effort}\""
  ],
  "efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max",
    "ultra"
  ],
  "models": {
    "args": [
      "debug",
      "models"
    ],
    "format": "json",
    "items": "models",
    "id": "slug",
    "efforts": {
      "list": "supported_reasoning_levels",
      "field": "effort"
    },
    "default_effort": "default_reasoning_level",
    "skip": {
      "visibility": "hide"
    }
  },
  "start": [
    "exec",
    "--json",
    "-c",
    "approval_policy=\"never\"",
    "{model}",
    "{effort}",
    "{access}",
    "--cd",
    "{cwd}",
    "-"
  ],
  "resume": [
    "exec",
    "resume",
    "--json",
    "-c",
    "approval_policy=\"never\"",
    "{model}",
    "{effort}",
    "{access}",
    "{session}",
    "-"
  ],
  "session": {
    "source": "event",
    "match": {
      "type": "thread.started"
    },
    "field": "thread_id"
  },
  "output": {
    "format": "jsonl",
    "final": {
      "match": {
        "type": "item.completed",
        "item.type": "agent_message"
      },
      "field": "item.text"
    },
    "error": [
      {
        "match": {
          "type": "error"
        },
        "field": "message"
      },
      {
        "match": {
          "type": "turn.failed"
        },
        "field": [
          "error.message",
          "error"
        ]
      }
    ]
  },
  "progress": [
    {
      "label": "reply",
      "match": {
        "type": "item.completed",
        "item.type": "agent_message"
      },
      "field": "item.text"
    }
  ],
  "interactive": [
    "resume",
    "{session}"
  ],
  "notes": "`exec resume` has no --sandbox flag, so resume keeps the level through the sandbox_mode config key. approval_policy=never refuses anything outside the sandbox instead of prompting."
}

{
  "name": "qwen",
  "executable": "qwen",
  "verified": {
    "version": "0.28.0",
    "on": "2026-11-24",
    "live_run": true
  },
  "help": [
    {
      "args": [
        "--help"
      ],
      "flags": [
        "--output-format",
        "--approval-mode",
        "--session-id",
        "--resume",
        "--model",
        "--prompt-interactive",
        "--allowed-tools"
      ]
    }
  ],
  "prompt": "stdin",
  "access": {
    "read-only": [
      "--approval-mode",
      "plan",
      "--allowed-tools",
      "web_fetch"
    ],
    "native-write": [
      "--approval-mode",
      "auto-edit",
      "--allowed-tools",
      "web_fetch"
    ]
  },
  "model": [
    "--model",
    "{model}"
  ],
  "start": [
    "-o",
    "stream-json",
    "{access}",
    "--session-id",
    "{session}",
    "{model}"
  ],
  "resume": [
    "-o",
    "stream-json",
    "{access}",
    "--resume",
    "{session}",
    "{model}"
  ],
  "interactive_start": [
    "{access}",
    "--session-id",
    "{session}",
    "{model}",
    "--prompt-interactive",
    "{opening}"
  ],
  "session": {
    "source": "preassign"
  },
  "output": {
    "format": "jsonl",
    "final": {
      "match": {
        "type": "result",
        "is_error": false
      },
      "field": "result"
    },
    "error": [
      {
        "match": {
          "type": "result",
          "is_error": true
        },
        "field": [
          "result",
          "subtype"
        ]
      }
    ]
  },
  "progress": [
    {
      "label": "reply",
      "match": {
        "type": "assistant"
      },
      "field": "message.content",
      "transform": "text_parts"
    }
  ],
  "interactive": [
    "--resume",
    "{session}"
  ],
  "notes": "One read-only start turn ran on 0.25.2 and kept the preassigned session ID; on 0.28.0 one read-only turn and one native-write turn ran. The write level is auto-edit, which approves edits without asking and has no directory isolation: on 0.28.0 it created a file in the parent of the run directory without approval. Resume is not exercised. --allowed-tools web_fetch approves page fetching, which a non-interactive turn otherwise refuses; one read-only turn on 0.25.2 fetched a page with it. Web search is absent until a search provider is configured in Qwen."
}

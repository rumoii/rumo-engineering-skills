{
  "name": "claude",
  "executable": "claude",
  "verified": {
    "version": "2.1.305 (Claude Code)",
    "on": "2026-10-21",
    "live_run": false
  },
  "help": [
    {
      "args": [
        "--help"
      ],
      "flags": [
        "--print",
        "--output-format",
        "--verbose",
        "--permission-mode",
        "--session-id",
        "--resume",
        "--model",
        "--name"
      ]
    }
  ],
  "prompt": "stdin",
  "access": {
    "read-only": [
      "--permission-mode",
      "plan"
    ],
    "workspace-write": [
      "--permission-mode",
      "acceptEdits"
    ]
  },
  "model": [
    "--model",
    "{model}"
  ],
  "start": [
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "{access}",
    "--session-id",
    "{session}",
    "{model}"
  ],
  "resume": [
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "{access}",
    "--resume",
    "{session}",
    "{model}"
  ],
  "interactive_start": [
    "{access}",
    "--session-id",
    "{session}",
    "--name",
    "{run_name}",
    "{model}",
    "{opening}"
  ],
  "session": {
    "source": "preassign"
  },
  "output": {
    "format": "jsonl",
    "final": {
      "match": {
        "type": "result",
        "is_error": false
      },
      "field": "result"
    },
    "error": [
      {
        "match": {
          "type": "result",
          "is_error": true
        },
        "field": [
          "result",
          "subtype"
        ]
      }
    ]
  },
  "progress": [
    {
      "label": "reply",
      "match": {
        "type": "assistant"
      },
      "field": "message.content",
      "transform": "text_parts"
    }
  ],
  "interactive": [
    "--resume",
    "{session}"
  ],
  "notes": "stream-json with --print requires --verbose. acceptEdits approves file edits only; shell commands that need approval are refused in print mode."
}

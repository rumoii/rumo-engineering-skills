{
  "name": "grok",
  "executable": "grok",
  "verified": {
    "version": "grok 1.0.70",
    "on": "2026-11-17",
    "live_run": true
  },
  "help": [
    {
      "args": [
        "--help"
      ],
      "flags": [
        "--prompt-file",
        "--output-format",
        "--permission-mode",
        "--session-id",
        "--resume",
        "--no-subagents",
        "--model",
        "--reasoning-effort",
        "--disallowed-tools",
        "--allow"
      ]
    }
  ],
  "prompt": "file",
  "access": {
    "read-only": [
      "--permission-mode",
      "plan",
      "--disallowed-tools",
      "run_terminal_command",
      "--allow",
      "WebFetch"
    ]
  },
  "model": [
    "--model",
    "{model}"
  ],
  "effort": [
    "--reasoning-effort",
    "{effort}"
  ],
  "efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "models": {
    "args": [
      "models"
    ],
    "format": "text",
    "pattern": "^\\s+[*-]\\s+(?P<id>[\\w.:/-]+)"
  },
  "start": [
    "--prompt-file",
    "{prompt_file}",
    "--output-format",
    "streaming-messages-json",
    "--no-subagents",
    "{access}",
    "-s",
    "{session}",
    "{model}",
    "{effort}"
  ],
  "resume": [
    "--prompt-file",
    "{prompt_file}",
    "--output-format",
    "streaming-messages-json",
    "--no-subagents",
    "{access}",
    "--resume",
    "{session}",
    "{model}",
    "{effort}"
  ],
  "interactive_start": [
    "--no-subagents",
    "{access}",
    "-s",
    "{session}",
    "{model}",
    "{effort}",
    "{opening}"
  ],
  "session": {
    "source": "preassign"
  },
  "output": {
    "format": "jsonl",
    "final": {
      "match": {
        "type": "result",
        "is_error": false
      },
      "field": "result"
    },
    "error": [
      {
        "match": {
          "type": "result",
          "is_error": true
        },
        "field": [
          "errors",
          "result",
          "subtype"
        ]
      }
    ],
    "end": {
      "match": {
        "type": "result"
      }
    }
  },
  "interactive": [
    "--resume",
    "{session}"
  ],
  "notes": "Read-only only: the write level would need grok's --sandbox profile, which is not confirmed on every platform. Read-only removes run_terminal_command: in plan mode a refused shell command cancels the whole headless turn, while grep, read_file, and list_dir remain. --allow WebFetch approves page fetching: a headless turn cannot ask, and on 1.0.88 a fetch outside grok's default domain allowlist otherwise cancelled the whole turn; web_search needs no approval.On 1.0.70 a read-only turn asked to run a command answered without one, and a resume turn ran; both exited on their own. A resume on 1.0.70 once printed its result and never exited, so output.end stops it. The model list comes from a local cache that opening grok refreshes; an 'unknown model id' error can mean a stale cache. The signed-out error event shape is from 1.0.41."
}

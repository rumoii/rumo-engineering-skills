{
  "name": "grok",
  "executable": "grok",
  "verified": {
    "version": "grok 1.0.41",
    "on": "2026-10-23",
    "live_run": true
  },
  "help": [
    {
      "args": [
        "--help"
      ],
      "flags": [
        "--prompt-file",
        "--output-format",
        "--permission-mode",
        "--session-id",
        "--resume",
        "--no-subagents",
        "--model",
        "--reasoning-effort"
      ]
    }
  ],
  "prompt": "file",
  "access": {
    "read-only": [
      "--permission-mode",
      "plan"
    ]
  },
  "model": [
    "--model",
    "{model}"
  ],
  "effort": [
    "--reasoning-effort",
    "{effort}"
  ],
  "efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "start": [
    "--prompt-file",
    "{prompt_file}",
    "--output-format",
    "streaming-messages-json",
    "--no-subagents",
    "{access}",
    "-s",
    "{session}",
    "{model}",
    "{effort}"
  ],
  "resume": [
    "--prompt-file",
    "{prompt_file}",
    "--output-format",
    "streaming-messages-json",
    "--no-subagents",
    "{access}",
    "--resume",
    "{session}",
    "{model}",
    "{effort}"
  ],
  "interactive_start": [
    "--no-subagents",
    "{access}",
    "-s",
    "{session}",
    "{model}",
    "{effort}",
    "{opening}"
  ],
  "session": {
    "source": "preassign"
  },
  "output": {
    "format": "jsonl",
    "final": {
      "match": {
        "type": "result",
        "is_error": false
      },
      "field": "result"
    },
    "error": [
      {
        "match": {
          "type": "result",
          "is_error": true
        },
        "field": [
          "errors",
          "result",
          "subtype"
        ]
      }
    ]
  },
  "interactive": [
    "--resume",
    "{session}"
  ],
  "notes": "Read-only only: the write level would need grok's --sandbox profile, which is not confirmed on every platform. On 1.0.41 one signed-in read-only turn with --reasoning-effort ran; the signed-out error event shape is also real."
}
